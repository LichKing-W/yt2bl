# YouTube API配置
YOUTUBE_API_KEY=
# YouTube cookies文件路径（用于绕过机器人检测，使用Netscape格式）
# 从浏览器导出cookies: https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
YOUTUBE_COOKIES_FILE=

# 代理配置（用于访问YouTube）
# HTTP/HTTPS 代理地址（例如: http://127.0.0.1:7897）
PROXY=

# Bilibili配置
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_DedeUserID=

# OpenAI配置（用于字幕翻译）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 下载配置
DOWNLOAD_PATH=./data
MAX_VIDEO_SIZE_MB=500
VIDEO_QUALITY=1080p

# 上传配置
UPLOAD_COOLDOWN_HOURS=2
AUTO_PUBLISH=false

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# FFmpeg配置
# 硬件加速类型: auto(自动检测), nvenc(NVIDIA), qsv(Intel), amf(AMD), videotoolbox(macOS), vaapi(Linux), none(软件编码)
FFMPEG_HWACCEL=auto
# 编码器预设: fast, medium, slow等（影响编码速度和质量）
FFMPEG_PRESET=fast

# 订阅监控配置
# 检查间隔（秒），默认3600（1小时）
SUBSCRIPTION_CHECK_INTERVAL=3600
# 每个频道获取的最新视频数量
SUBSCRIPTION_VIDEOS_PER_CHANNEL=3
